# 图床配置（社区图片上传用）
# 示例：https://img.yousn.me/
CF_UPLOAD_URL=""
CF_AUTH_TOKEN=""

# 默认模型提供商配置（采集与 AI 接口用）
# baseUrl 示例：https://api.yousn.me/v1
DEFAULT_PROVIDER_BASE_URL="https://api.yousn.me/v1"
DEFAULT_PROVIDER_API_KEY=""

# 采集脚本专用模型配置（未配置时脚本会直接退出）
OPENAI_BASE_URL="https://api.yousn.me/v1"
OPENAI_API_KEY=""
OPENAI_MODEL="openai/gpt-oss-120b"

# Cookie 会话密钥（鉴权用，至少 32 位随机字符串）
SESSION_SECRET=""

# 可选：采集脚本调试输出
COLLECT_WRITE_DEBUG_FILES="false"
